# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials. Loaded automatically by run.py and api.py via
# python-dotenv, so every process picks these up without a manual `export` in
# each terminal.

# --- Razorpay test-mode keys ------------------------------------------------
# Dashboard (Test Mode) -> Settings -> API Keys -> Generate Test Key.
# Needed for: run.py --live-link INV-XXXX, and the dashboard's "Live demo send".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP, for the one real demo email --------------------------------------
# Gmail: SMTP_USER is your address; SMTP_PASSWORD is a 16-character App
# Password from https://myaccount.google.com/apppasswords (NOT your normal
# Gmail password - requires 2-Step Verification to be on). Any SMTP provider
# works if you set SMTP_HOST/SMTP_PORT accordingly.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Local LLM (optional - everything works without it via --no-llm) -------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
